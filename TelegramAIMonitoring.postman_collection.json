{
  "info": {
    "name": "Telegram AI Monitoring API",
    "_postman_id": "telegram-ai-monitoring-collection-id",
    "description": "\u041a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 \u0434\u043b\u044f \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0430 Telegram AI Monitoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Telegram Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegram_id\": 123456789,\n  \"username\": \"roma\",\n  \"first_name\": \"Roma\",\n  \"auth_date\": 1719999999,\n  \"hash\": \"VALID_HASH\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/telegram",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "telegram"
              ]
            }
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Moderation",
      "item": [
        {
          "name": "List Pending Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/messages?status=PENDING",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/messages/{{message_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages",
                "{{message_id}}",
                "approve"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"AI Project\", \"description\": \"Demo\"}"
            },
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Subprojects",
      "item": [
        {
          "name": "Create Subproject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"project_id\": \"{{project_id}}\", \"name\": \"Sub A\"}"
            },
            "url": {
              "raw": "{{base_url}}/subprojects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "subprojects"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Prompts",
      "item": [
        {
          "name": "Create Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"subproject_id\": \"{{subproject_id}}\", \"name\": \"Prompt A\", \"description\": \"desc\"}"
            },
            "url": {
              "raw": "{{base_url}}/prompts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prompts"
              ]
            }
          }
        },
        {
          "name": "Create Prompt Settings Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"version\": 1, \"model\": \"gpt-4\", \"temperature\": 0.7, \"system_prompt\": \"You are a helpful AI assistant\"}"
            },
            "url": {
              "raw": "{{base_url}}/prompts/{{prompt_id}}/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prompts",
                "{{prompt_id}}",
                "settings"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Telegram Integrations",
      "item": [
        {
          "name": "Add Telegram Bot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"bot\", \"bot_token\": \"123456:ABC-DEF\"}"
            },
            "url": {
              "raw": "{{base_url}}/telegram/integrations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "telegram",
                "integrations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Get Stats by Prompt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stats/prompt/{{prompt_id}}?version=1&period=7d",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stats",
                "prompt",
                "{{prompt_id}}"
              ],
              "query": [
                {
                  "key": "version",
                  "value": "1"
                },
                {
                  "key": "period",
                  "value": "7d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like a Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/messages/{{message_id}}/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages",
                "{{message_id}}",
                "like"
              ]
            }
          }
        }
      ]
    }
  ]
}